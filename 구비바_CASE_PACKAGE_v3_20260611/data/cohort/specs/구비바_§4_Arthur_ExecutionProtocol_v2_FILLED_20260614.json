        "channel_detail_url"
      ]
    },
    {
      "task_id": "enrich_category_and_follower",
      "mode": "collect",
      "cohort_type": "category_and_follower_enrichment",
      "description": "랭킹 수집 채널 중 구비바 peak band 범위(raw_max 74~296) 해당 채널의 상세 페이지 방문 → 카테고리 비율 + 팔로워 수 추출",
      "source_id": "softcone_detail",
      "depends_on": ["collect_main_population", "collect_aux_virtual"],
      "channel_filter": {
        "criterion": "peak_viewers",
        "range_min": 74,
        "range_max": 296,
        "note": "구비바 raw_max=148의 0.5~2.0배. 랭킹 페이지의 peak_viewers(최고시청자) 기준 필터링. 이 범위 밖 채널도 p95/median band로 잡힐 수 있으므로 넉넉히 설정.",
        "extended_range_max": 500,
        "extended_range_note": "소프트콘의 '최고시청자'가 7일 기준이라 raw_max보다 낮을 수 있음. 넉넉히 잡고 후필터."
      },
      "save_raw": true,
      "max_requests": 150,
      "output": ["raw/detail/{channel_id}.html", "parsed/detail_enriched.jsonl"],
      "columns_to_extract": [
        "channel_id", "channel_name", "follower_count", "follower_updated_at",
        "peak_viewers", "avg_viewers", "viewership", "total_stream_hours",
        "category_1", "category_1_share",
        "category_2", "category_2_share",
        "category_3", "category_3_share",
        "peak_rank", "peak_follower"
      ],
      "general_game_classification": {
        "method": "category_share_analysis",
        "rules": [
          "2개 이상 게임 카테고리에 각 15%+ share → is_general_game=true, basis='multi_game_share'",
          "단일 게임 80%+ → is_general_game=false, basis='single_game_dominant'",
          "talk/just chatting 1순위 50%+ → is_general_game=false, basis='talk_dominant'",
          "종합게임 카테고리가 category_1이면 → is_general_game=true, basis='category_label'",
          "판정 불명확 → is_general_game='unknown', basis='manual_review_needed'"
        ]
      }
    },
    {
      "task_id": "supplement_followers",
      "mode": "collect",
      "cohort_type": "follower_match",
      "description": "enrich 단계에서 팔로워 누락 채널을 팔로워 랭킹에서 매칭",
      "source_id": "softcone_followers",
      "depends_on": ["enrich_category_and_follower"],
      "save_raw": true,
